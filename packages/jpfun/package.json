{
  "name": "jpfun",
  "version": "0.3.0",
  "description": "A functional numbered musical notation typesetting engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "grammar.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madderscientist/jpFun.git",
    "directory": "packages/jpfun"
  },
  "homepage": "https://github.com/madderscientist/jpFun#readme",
  "bugs": {
    "url": "https://github.com/madderscientist/jpFun/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"for (const path of ['dist', 'tsconfig.tsbuildinfo']) require('node:fs').rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p test/tsconfig.json",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:update": "node --import tsx --test \"test/*.test.ts\""
  },
  "keywords": [
    "numbered-musical-notation",
    "jianpu",
    "music-notation",
    "sheet-music",
    "typesetting"
  ],
  "author": "madderscientist",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}