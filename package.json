{
  "name": "jpfun-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && pnpm run build:core && pnpm run build:playground",
    "build:core": "pnpm --filter jpfun build",
    "build:playground": "pnpm --filter @jpfun/playground build",
    "test": "pnpm --filter jpfun test",
    "test:update": "pnpm --filter jpfun test:update",
    "typecheck": "pnpm --filter jpfun typecheck",
    "predev": "pnpm run build:core",
    "dev": "node scripts/dev-server.mjs"
  }
}