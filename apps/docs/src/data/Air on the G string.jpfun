@page(width=793px, height=1122px, top=37px, bottom=75px, left=30px, right=30px, numbering=1/1)
H.title: Air on the G string
H.author: Johann Sebastian Bach
H.signature: 1=C4 4/4
H.tempo: 33

N("Violin I"): { @program(40) F#5@mx0 - - - | F#5/@mx1 @tie(mx0, mx1) B5// G5// {{F#5} > E5//} D5// C#5// D5// C#5 {{B4} > A4} | A5 - A5// F#5// C5// B4// E5// D#5// A5// G5// | }
N("Violin II"): { @program(40) D5@mx26 - - - | D5@mx27 @tie(mx26, mx27) B4 A4 - | A4/ C5// B4// C5/ A5// C5// B4/ 0/ 0 | }
N("Viola"): { @program(41) A4 - B4 - | B3 E4 E4 - | E4/ D#4 E4/ F#4/ 0/ 0 | }
N("Violoncello"): { @program(42) D3/ D4/ C#4/ C#3/ B2/ B3/ A3/ A2/ | G2/ G3/ G#3/ G#2/ A2/ A3/ G3/ G2/ | F#2/ F#3/ E3/ E2/ D#2/ D#3/ B2/ B3/ | }

